<idea-plugin>
    <id>com.xixka.topstatusbar</id>
    <name>Top Status Bar</name>
    <vendor>xixka</vendor>
    <description><![CDATA[A compact, New UI-style status bar rendered as a single custom toolbar component.<br/>
    Add the "Top Status Bar" action to the Main Toolbar via Settings &#8594; Appearance &amp; Behavior &#8594; Menus and Toolbars
    to show editor, project, VCS and runtime status next to the search icon.]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.xixka.topstatusbar.TopStatusBarManager"/>
        <projectConfigurable id="topStatusBar"
                              parentId="appearance"
                              displayName="Top Status Bar"
                              instance="com.xixka.topstatusbar.settings.TopStatusBarConfigurable"/>
        <notificationGroup id="TopStatusBar" displayType="BALLOON"/>
        <!-- Deliberately NO `statusBarWidgetFactory` registrations (2026-09-20,
             third turn of this decision):
             2026.x frontend-izes the status bar and synthesizes a SECOND set
             of "Status Bar Widgets" menu entries for every classic factory
             extension, backed by a separate toggle store that this plugin
             cannot read. Registering our own factories therefore produced
             duplicated menu entries whose states disagree, and toggling the
             "wrong" copy never affected the top bar (user screenshot
             2026-09-20: all six plugin items doubled with mismatched
             checkboxes, native items single). The fix is the hybrid source
             of truth: the 11 items mirroring built-in widgets follow the
             native menu (read from the persisted StatusBarWidgetSettings,
             see TopStatusBarManager.isDisplayEnabled); the 6 plugin-specific
             items are controlled by this plugin's own settings page
             (Settings | Appearance | Top Status Bar) on every platform
             version. The manager also detects stale factories from an old
             plugin copy left on disk and notifies the user. -->
    </extensions>

    <actions>
        <!-- Single root-level entry: the action registers directly at the action
             system root, so "Top Status Bar" appears exactly once in the "Add
             Action" tree of the native toolbar customization dialog and can be
             placed into the Main Toolbar without any custom UI patching. -->
        <action id="TopStatusBar.Widget"
                class="com.xixka.topstatusbar.TopStatusBarAction"
                text="Top Status Bar"
                description="Compact status bar for the Main Toolbar (New UI)"/>
    </actions>
</idea-plugin>
