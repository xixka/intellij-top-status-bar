<idea-plugin>
    <id>com.xixka.topstatusbar</id>
    <name>Top Status Bar</name>
    <vendor>xixka</vendor>
    <description><![CDATA[A compact, New UI-style status bar rendered as a single custom toolbar component.<br/>
    Add the "Top Status Bar" action to the Main Toolbar via Settings &#8594; Appearance &amp; Behavior &#8594; Menus and Toolbars
    to show editor, project, VCS and runtime status next to the search icon.]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.xixka.topstatusbar.TopStatusBarManager"/>
        <projectConfigurable id="topStatusBar"
                              parentId="appearance"
                              displayName="Top Status Bar"
                              instance="com.xixka.topstatusbar.settings.TopStatusBarConfigurable"/>
        <notificationGroup id="TopStatusBar" displayType="BALLOON"/>
        <!-- Plugin-specific items are exposed as native "Status Bar Widgets"
             toggles (right-click the bottom status bar or View | Appearance |
             Status Bar Widgets) so that the native menu governs the whole top
             bar (2026-09-20: show exactly what the system settings select).
             The factories create invisible zero-size widgets. The toggle
             state itself is read from the persisted StatusBarWidgetSettings
             (see TopStatusBarManager.isDisplayEnabled), never from widget
             presence — 2026.x no longer hosts many widgets on the bottom
             bar. The sync widget only provides instant notifications on
             platforms that still host legacy custom widgets. -->
        <statusBarWidgetFactory id="statusText"
                                implementation="com.xixka.topstatusbar.widget.TopBarItemWidgetFactories$StatusText"/>
        <statusBarWidgetFactory id="fileSystemSync"
                                implementation="com.xixka.topstatusbar.widget.TopBarItemWidgetFactories$FileSystemSync"/>
        <statusBarWidgetFactory id="codeBuddy"
                                implementation="com.xixka.topstatusbar.widget.TopBarItemWidgetFactories$CodeBuddy"/>
        <statusBarWidgetFactory id="aggregator"
                                implementation="com.xixka.topstatusbar.widget.TopBarItemWidgetFactories$Aggregator"/>
        <statusBarWidgetFactory id="networkLocation"
                                implementation="com.xixka.topstatusbar.widget.TopBarItemWidgetFactories$NetworkLocation"/>
        <statusBarWidgetFactory id="deployServer"
                                implementation="com.xixka.topstatusbar.widget.TopBarItemWidgetFactories$DeployServer"/>
    </extensions>

    <actions>
        <!-- Single root-level entry: the action registers directly at the action
             system root, so "Top Status Bar" appears exactly once in the "Add
             Action" tree of the native toolbar customization dialog and can be
             placed into the Main Toolbar without any custom UI patching. -->
        <action id="TopStatusBar.Widget"
                class="com.xixka.topstatusbar.TopStatusBarAction"
                text="Top Status Bar"
                description="Compact status bar for the Main Toolbar (New UI)"/>
    </actions>
</idea-plugin>
