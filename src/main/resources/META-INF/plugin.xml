<idea-plugin>
    <id>com.xixka.topstatusbar</id>
    <name>Top Status Bar</name>
    <vendor>xixka</vendor>
    <description><![CDATA[A compact, New UI-style status bar rendered as a single custom toolbar component.<br/>
    Add the "Top Status Bar" action to the Main Toolbar via Settings &#8594; Appearance &amp; Behavior &#8594; Menus and Toolbars
    to show editor, project, VCS and runtime status next to the search icon.]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="com.xixka.topstatusbar.TopStatusBarManager"/>
        <projectConfigurable id="topStatusBar"
                              parentId="appearance"
                              displayName="Top Status Bar"
                              instance="com.xixka.topstatusbar.settings.TopStatusBarConfigurable"/>
        <notificationGroup id="TopStatusBar" displayType="BALLOON"/>
        <!-- Plugin-specific items are exposed as native "Status Bar Widgets"
             toggles (right-click the bottom status bar or View | Appearance |
             Status Bar Widgets). The factories create invisible zero-size
             widgets; the top bar reads their presence via the public
             StatusBar.getWidget(id) API and hides the item while the toggle
             is off. Items mirroring built-in widgets (editor position,
             encoding, Git branch, ...) already follow their native toggles. -->
    </extensions>

    <actions>
        <!-- Single root-level entry: the action registers directly at the action
             system root, so "Top Status Bar" appears exactly once in the "Add
             Action" tree of the native toolbar customization dialog and can be
             placed into the Main Toolbar without any custom UI patching. -->
        <action id="TopStatusBar.Widget"
                class="com.xixka.topstatusbar.TopStatusBarAction"
                text="Top Status Bar"
                description="Compact status bar for the Main Toolbar (New UI)"/>
    </actions>
</idea-plugin>
